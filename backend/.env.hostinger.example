APP_NAME="Nurul Iman Academic Integrated System"
APP_ENV=production
APP_KEY=__COPY_APP_KEY_DARI_RUMAHWEB__
APP_DEBUG=false
APP_URL=https://nuris.byethost31.com
FRONTEND_URL=https://nuris.byethost31.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__DATABASE_HOSTINGER__
DB_USERNAME=__USER_DATABASE_HOSTINGER__
DB_PASSWORD=__PASSWORD_DATABASE_HOSTINGER__

CORS_ALLOWED_ORIGINS=https://nuris.byethost31.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS=__ALAMAT_EMAIL_INSTITUSI__
MAIL_FROM_NAME="Nurul Iman Academic Integrated System"

VAPID_PUBLIC_KEY=__COPY_DARI_RUMAHWEB__
VAPID_PRIVATE_KEY=__COPY_DARI_RUMAHWEB__
VAPID_SUBJECT=mailto:__ALAMAT_EMAIL_INSTITUSI__

MIGRATION_ENDPOINTS_ENABLED=false
MIGRATION_ENDPOINT_KEY=
